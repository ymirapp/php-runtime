includes:
    - ./phpstan-baseline.neon
parameters:
    level: 9
    paths:
        - src
    reportUnmatchedIgnoredErrors: false
    excludePaths:
        - src/acorn-config-cache.php
        - src/laravel-config-cache.php
        - templates/*
        - tests/*
    ignoreErrors:
        - identifier: missingType.iterableValue
